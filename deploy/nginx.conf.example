# /etc/nginx/sites-available/iot.example.com  (then symlink into sites-enabled)
# Replace iot.example.com with your domain. Get the cert first:
#   sudo certbot certonly --nginx -d iot.example.com
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name iot.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name iot.example.com;
  ssl_certificate     /etc/letsencrypt/live/iot.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/iot.example.com/privkey.pem;

  # MQTT over WebSocket for the dashboard (mosquitto listener 127.0.0.1:9001)
  location /mqtt {
    proxy_pass http://127.0.0.1:9001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }

  # API + dashboard. /broker/* is on a different port and never proxied.
  location / {
    proxy_pass http://127.0.0.1:3020;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
